<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Smoke" parallel="methods" thread-count="4">
    <listeners>
        <listener class-name="com.mudassir.tests.listeners.RetryTransformer"/>
        <listener class-name="com.mudassir.tests.listeners.FailureListener"/>
    </listeners>
    <test name="Smoke">
        <groups><run><include name="smoke"/></run></groups>
        <packages>
            <package name="com.mudassir.tests.api"/>
            <package name="com.mudassir.tests.ui"/>
        </packages>
    </test>
</suite>
