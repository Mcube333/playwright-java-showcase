<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Regression" parallel="methods" thread-count="4" data-provider-thread-count="3">
    <listeners>
        <listener class-name="com.mudassir.tests.listeners.RetryTransformer"/>
        <listener class-name="com.mudassir.tests.listeners.FailureListener"/>
    </listeners>
    <test name="API">
        <packages><package name="com.mudassir.tests.api"/></packages>
    </test>
    <test name="UI">
        <packages><package name="com.mudassir.tests.ui"/></packages>
    </test>
</suite>
